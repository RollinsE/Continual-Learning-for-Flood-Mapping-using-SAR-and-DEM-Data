{
  "schema_version": 2,
  "model": {
    "architecture": "unet",
    "encoder": "resnet34",
    "modalities": ["vv", "vh"],
    "sar_units": "db10",
    "normalization_mode": "robust_minmax",
    "seed": 42,
    "training_epochs": 6,
    "selected_epoch": 6,
    "threshold": 0.8
  },
  "dataset": {
    "train_tiles": 3980,
    "validation_tiles": 324,
    "test_scenes": 386,
    "test_labels": "published masks (no morphological clean-up)"
  },
  "cross_validation": {
    "folds_planned": 5,
    "folds_run": [0, 1],
    "fold0_event_macro_f1": {"vv+vh": 0.4781, "vv+vh+dem": 0.4597}
  },
  "threshold_calibration": {
    "source": "out-of-fold predictions, folds 0 and 1",
    "threshold": 0.8,
    "event_macro_f1": 0.4240
  },
  "test": {
    "inference": "sliding_window, window 512, overlap 128",
    "metric_mode": "global",
    "f1": 0.5200,
    "iou": 0.3514,
    "precision": 0.4391,
    "recall": 0.6374,
    "mcc": 0.5081
  }
}
